# Copy to server/.env for local runs (git ignores it). In production these are set in the
# platform's dashboard / secret store — never baked into the image, never committed.
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info

# Sites allowed to open a WebSocket (comma-separated origins). Empty = only this server's own pages.
ALLOWED_ORIGINS=

MAX_CONNECTIONS_PER_IP=20
MAX_ROOMS=20
MAX_PLAYERS_PER_ROOM=8

# 1 when the server sits behind exactly one reverse proxy (Fly, Render, Caddy): then X-Forwarded-For counts
TRUSTED_PROXY_HOPS=0

# a secret: when set, GET /metrics needs `Authorization: Bearer <token>`
METRICS_TOKEN=
