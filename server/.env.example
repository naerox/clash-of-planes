# Copy to .env (git-ignored). `npm run dev` / `npm start` load it via --env-file-if-exists.
PORT=3000
HOST=127.0.0.1
LOG_DIR=./logs
# CLIENT_DIST=../client/dist
# ENABLE_DEBUG_ROUTES=1   # /api/slow and /api/replays-naive/:id (Lab 4 demos only)

# Lab 5
# ENABLE_NETSIM=1         # artificial lag/jitter/loss (?lag=100&jitter=30&drop=0.02, the F2 panel).
#                         # On by default, OFF when NODE_ENV=production.
# INPUT_RESERVE=1         # jitter buffer: keep this many inputs queued per player (0 = apply all at once)
