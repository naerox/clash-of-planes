{
  "name": "@dogfight/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "bots": "node scripts/bots.ts --spawn",
    "report": "node scripts/netcode-report.ts"
  },
  "dependencies": {
    "@dogfight/shared": "*",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2"
  }
}
